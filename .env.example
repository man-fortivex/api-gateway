APP_NAME=API Gateway SaaS
ENV=development

# Postgres in production; sqlite+aiosqlite works fine for local dev
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
# Only applied for non-SQLite databases
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://localhost:6379/0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USAGE_TOPIC=gateway.usage.events
KAFKA_ENABLED=true

PROXY_TIMEOUT_SECONDS=15
MAX_REQUEST_BODY_BYTES=5242880

# Upstream HTTP connection pool (tuned for heavy concurrent load)
PROXY_MAX_CONNECTIONS=500
PROXY_MAX_KEEPALIVE_CONNECTIONS=100
PROXY_KEEPALIVE_EXPIRY_SECONDS=30

# Multi-process scaling (see Dockerfile) — ignored when running uvicorn directly
WEB_CONCURRENCY=4

API_KEY_PREFIX=agw_
ADMIN_JWT_SECRET=replace-this-with-a-random-secret-in-production
ADMIN_JWT_EXPIRE_MINUTES=720

# Admin login — generate the hash with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Stripe metered billing (optional — leave disabled until you wire real Stripe products)
STRIPE_ENABLED=false
STRIPE_API_KEY=
# STRIPE_PLAN_PRICE_IDS is a JSON object, e.g. {"starter":"price_abc","pro":"price_xyz"}
STRIPE_PLAN_PRICE_IDS={}

# Distributed tracing (OpenTelemetry). Disabled by default — zero overhead
# unless turned on. Leave OTEL_EXPORTER_OTLP_ENDPOINT blank to print spans
# to stdout (console exporter, fine for local dev).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# GraphQL query-complexity budget (points per minute per key), only applied
# on a tenant's configured graphql_path
GRAPHQL_COMPLEXITY_POINTS_PER_MINUTE=500

# How long a rotated (old) API key stays valid after `rotate` is called
KEY_ROTATION_GRACE_SECONDS=86400

# Max response body size (bytes) eligible for the per-tenant response cache
RESPONSE_CACHE_MAX_BODY_BYTES=524288

# Upstream retry / circuit breaker tuning
PROXY_MAX_RETRIES=2
PROXY_RETRY_BACKOFF_BASE_SECONDS=0.2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
